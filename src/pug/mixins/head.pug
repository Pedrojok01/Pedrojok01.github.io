//- Head tags shared by every page. `root` prefixes local URLs: "" on the home page, "/" on
//- 404.html, which GitHub Pages serves at any missing path.
mixin head(root)
  -
    const fonts = [
      "schibsted-grotesk-latin-400-normal",
      "schibsted-grotesk-latin-500-normal",
      "schibsted-grotesk-latin-800-normal",
      "ibm-plex-mono-latin-400-normal",
    ];
  meta(charset="utf-8")
  meta(
    name="viewport",
    content="width=device-width, initial-scale=1, viewport-fit=cover"
  )
  meta(name="theme-color", content="#0f1624")
  link(rel="icon", href=`${root}favicon.ico`, sizes="32x32")
  link(rel="icon", href=`${root}favicon.svg`, type="image/svg+xml")
  link(rel="apple-touch-icon", href=`${root}apple-touch-icon.png`)

  // Fonts (self-hosted, see src/scss/_fonts.scss): preload the ones used above the fold
  each font in fonts
    link(
      rel="preload",
      href=`${root}assets/fonts/${font}.woff2`,
      as="font",
      type="font/woff2",
      crossorigin
    )

  // Apply the saved theme before the first paint (see the theme toggle in main.js)
  script.
    try {
      var t = localStorage.getItem("theme");
      if (t) document.documentElement.dataset.theme = t;
    } catch (e) {}
  link(href=root + asset("css/styles.css"), rel="stylesheet")
