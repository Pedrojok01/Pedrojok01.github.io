//- Project card: +project({ title, desc?, stack, url, img, repo?, featured? })
//- The thumbnail repeats the "Visit" link, so it is hidden from keyboard and screen readers.
mixin project(p)
  article.card(class=p.featured ? "is-featured" : null)
    a.thumb(
      href=p.url,
      target="_blank",
      rel="noopener noreferrer",
      tabindex="-1",
      aria-hidden="true"
    )
      img(
        src=`assets/img/${p.img}`,
        alt="",
        width="500",
        height="300",
        loading="lazy"
      )
    .card-body
      h3= p.title
      if p.desc
        p.desc= p.desc
      ul.stack
        each item in p.stack
          li= item
      .card-links
        a(href=p.url, target="_blank", rel="noopener noreferrer")
          | Visit #[span.visually-hidden #{ p.title }]
          +icon("solid/arrow-up-right-from-square")
        if p.repo
          a(href=p.repo, target="_blank", rel="noopener noreferrer")
            | GitHub #[span.visually-hidden repository for #{ p.title }]
            +icon("solid/arrow-up-right-from-square")
