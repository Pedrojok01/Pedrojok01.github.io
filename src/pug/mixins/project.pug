//- Portfolio card: +project({ title, desc?, stack, url, img, repo? })
//- Thumbnails are 500x300; width/height include the .img-thumbnail padding and border (2 x 5px)
//- so the reserved space matches the rendered size.
mixin project(p)
  .col-md-6.mb-4
    h3.mb-0= p.title
    if p.desc
      p.mb-1= p.desc
    p= p.stack
    a(href=p.url, target="_blank", rel="noopener noreferrer")
      img.mb-2.img-thumbnail(
        src=`assets/img/${p.img}`,
        alt=`${p.title} website thumbnail`,
        width="510",
        height="306",
        loading="lazy"
      )
    if p.repo
      p
        | GitHub:
        |
        a(href=p.repo)= p.repo
