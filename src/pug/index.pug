include mixins/icon
include mixins/project

-
  const site = {
    url: "https://pedrojok.com/",
    title: "Pierre Estrabaud · Tech Lead, AI Security Tooling",
    description:
      "Pierre Estrabaud - software engineer and Tech Lead on AuditAgent at Nethermind, working on AI, security and blockchain.",
    image: "https://pedrojok.com/dist/assets/img/profile.jpg",
  };

doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    meta(name="description", content=site.description)
    meta(name="author", content="Pierre Estrabaud")
    meta(name="theme-color", content="#374c85")

    title= site.title

    link(rel="canonical", href=site.url)
    link(rel="icon", type="image/x-icon", href="assets/img/favicon.ico")

    // Open Graph / social previews
    meta(property="og:type", content="website")
    meta(property="og:url", content=site.url)
    meta(property="og:title", content=site.title)
    meta(property="og:description", content=site.description)
    meta(property="og:image", content=site.image)
    meta(name="twitter:card", content="summary")

    // Fonts (self-hosted, see src/scss/_fonts.scss)
    each font in ["mulish-latin-400-normal", "mulish-latin-800-normal", "saira-extra-condensed-latin-500-normal", "saira-extra-condensed-latin-700-normal"]
      link(
        rel="preload",
        href=`assets/fonts/${font}.woff2`,
        as="font",
        type="font/woff2",
        crossorigin
      )

    // Core theme CSS (includes Bootstrap)
    link(href="css/styles.css", rel="stylesheet")

    // Icons: Font Awesome Free (https://fontawesome.com/license/free), inlined as SVG at build time

  body#page-top(data-bs-spy="scroll", data-bs-target="#sideNav")
    // Navigation
    nav#sideNav.navbar.navbar-expand-lg.navbar-dark.bg-primary.fixed-top
      a.navbar-brand(href="#page-top")
        span.d-block.d-lg-none Pierre Estrabaud
        span.d-none.d-lg-block
          img.img-fluid.img-profile.rounded-circle.mx-auto.mb-2(
            src="assets/img/profile.jpg",
            alt="Pierre Estrabaud",
            width="160",
            height="160"
          )
      button.navbar-toggler(
        type="button",
        data-bs-toggle="collapse",
        data-bs-target="#navbarSupportedContent",
        aria-controls="navbarSupportedContent",
        aria-expanded="false",
        aria-label="Toggle navigation"
      )
        span.navbar-toggler-icon
      #navbarSupportedContent.collapse.navbar-collapse
        ul.navbar-nav
          li.nav-item
            a.nav-link(href="#about") About
          li.nav-item
            a.nav-link(href="#experience") Experience
          li.nav-item
            a.nav-link(href="#skills") Skills
          li.nav-item
            a.nav-link(href="#portfolio") Portfolio
          li.nav-item
            a.nav-link(href="#education") Education
          li.nav-item
            a.nav-link(href="#awards") Awards
          li.nav-item
            a.nav-link(href="#interests") Interests

    // Page Content
    main.container-fluid.p-0
      // About
      section#about.resume-section
        .resume-section-content
          h1.mb-0
            | Pierre #[span.text-primary Estrabaud]
          .subheading.mb-5
            | Tech Lead · Software Engineer · AI Security Tooling ·
            | #[a(href="mailto:pierre.estrabaud@protonmail.com") pierre.estrabaud@protonmail.com]

          p.lead.mb-5
            | I'm a software engineer working at the intersection of AI, security and blockchain. I lead
            | engineering on #[a(href="https://auditagent.nethermind.io/") AuditAgent], Nethermind's AI security
            | scanner for smart contracts, after several years building dApps and writing Solidity smart contracts.

          .social-icons.lead.mb-5
            a.social-icon(
              href="https://www.linkedin.com/in/pierre-e/",
              aria-label="LinkedIn"
            )
              +icon("brands/linkedin-in")
            a.social-icon(
              href="https://github.com/Pedrojok01",
              aria-label="GitHub"
            )
              +icon("brands/github")
            a.social-icon(href="https://t.me/Pedrojok", aria-label="Telegram")
              +icon("brands/telegram")
            a.social-icon(href="https://blog.pedrojok.com", aria-label="Blog")
              +icon("solid/globe")

          p.mb-3
            | I also write about web3 security and CTF challenges on my blog:
            | #[a(href="https://blog.pedrojok.com") Web3 Security].

      hr.m-0

      // Experience
      section#experience.resume-section
        .resume-section-content
          h2.mb-5 Experience

          // Nethermind: one company, several roles (newest first)
          .d-flex.flex-column.flex-md-row.justify-content-between.mb-3
            .flex-grow-1
              h3.mb-0 Nethermind
              .subheading.mb-3 Remote
              p
                a(href="https://www.nethermind.io/") https://www.nethermind.io/
            .flex-shrink-0
              span.text-primary April 2024 - Present

          .role-group.mb-5
            .role.d-flex.flex-column.flex-md-row.justify-content-between
              .flex-grow-1
                h4.mb-2 Tech Lead, AuditAgent
                p
                  | • Lead a team of 4 engineers building
                  | #[a(href="https://auditagent.nethermind.io/") AuditAgent], an AI security scanner for
                  | Solidity, Cairo and Rust smart contracts.
                p
                  | • Run the AI security scanner on Kubernetes, with KEDA autoscaling.
                p
                  | • 6M+ lines of code scanned and 44K+ vulnerabilities found so far.
              .flex-shrink-0
                span.text-primary November 2024 - Present

            .role.d-flex.flex-column.flex-md-row.justify-content-between
              .flex-grow-1
                h4.mb-2 AI Security Engineer, AuditAgent
                p
                  | • Joined the AuditAgent team after my internship to build an AI-powered security solution
                  | that identifies vulnerabilities in smart contracts.
              .flex-shrink-0
                span.text-primary August 2024 - November 2024

            .role.d-flex.flex-column.flex-md-row.justify-content-between
              .flex-grow-1
                h4.mb-2 Smart Contracts Auditor (Intern), Audit Team
                p
                  | • Audited Solidity (EVM) and Cairo codebases to identify and mitigate security
                  | vulnerabilities.
                p
                  | • Reviewed and analyzed audit findings to ensure the reliability and safety of blockchain
                  | applications.
              .flex-shrink-0
                span.text-primary April 2024 - July 2024

          .d-flex.flex-column.flex-md-row.justify-content-between.mb-5
            .flex-grow-1
              h3.mb-0 Lead Blockchain Developer
              .subheading.mb-3 Meed (formerly SuperUltra) - Remote
              p
                | <a href="https://www.meedloyalty.com/">https://www.meedloyalty.com/</a>
              p
                | • Engineered and developed 5 blockchain-based solutions (DApps), from smart contracts to
                | back-end and front-end integration across 4 EVM networks, including Ethereum, Polygon, BSC, and Cronos.
              p
                | • Collaborated remotely with a team of 5-10 people in a dynamic startup environment, leveraging agile methodologies.
              p
                | • Provided strategic guidance to clients on the development of Web3 products and games, ensuring solid
                | blockchain integration for improved functionality and user engagement.

            .flex-shrink-0
              span.text-primary January 2022 - November 2023

          .d-flex.flex-column.flex-md-row.justify-content-between.mb-5
            .flex-grow-1
              h3.mb-0 Cryptocurrency Miner
              .subheading.mb-3 Self-employed - Thailand
              p
                | Ran a mining farm of ASIC miners (3 algorithms) and a self-built 6-GPU rig, tuned for efficiency
                | through BIOS flashing, overclocking and undervolting.
            .flex-shrink-0
              span.text-primary October 2017 - July 2022

          .d-flex.flex-column.flex-md-row.justify-content-between.mb-5
            .flex-grow-1
              h3.mb-0 Blockchain Developer
              .subheading.mb-3 Freelance
              p
                | • Developed and deployed smart contracts for multiple DApps, with a focus on enhancing user
                | experience by creating intuitive front-ends.
              p
                | • Committed to continuous learning by staying updated on the latest developments in the Ethereum
                | ecosystem, Solidity best practices, and Web3 technologies.
            .flex-shrink-0
              span.text-primary July 2020 - December 2021

          .d-flex.flex-column.flex-md-row.justify-content-between.mb-5
            .flex-grow-1
              h3.mb-0 Translator Crypto and IT | English to French
              .subheading.mb-3 Freelance
              p
                | Clients: <a href="https://phemex.com">Phemex</a>, <a href="https://paybis.com/">Paybis</a>, Microsoft Azure
              p
                | Translated 30+ technical white papers during the 2017/2018 ICO boom.
            .flex-shrink-0
              span.text-primary August 2017 - June 2021

          .d-flex.flex-column.flex-md-row.justify-content-between
            .flex-grow-1
              h3.mb-0 Earlier
              p
                | Owner and manager of an internet cafe in Bangkok (2011 - 2012), and IT help desk for the
                | 1,500+ Système U supermarkets in Montpellier (2007 - 2008).
            .flex-shrink-0
              span.text-primary 2007 - 2012

      hr.m-0

      // Skills
      section#skills.resume-section
        .resume-section-content
          h2.mb-5 Skills
          .subheading.mb-3 Programming Languages & Tools
          ul.list-inline.dev-icons
            li.list-inline-item(title="Python")
              +icon("brands/python")
            li.list-inline-item(title="JavaScript")
              +icon("brands/square-js")
            li.list-inline-item(title="React")
              +icon("brands/react")
            li.list-inline-item(title="Node.js")
              +icon("brands/node-js")
            li.list-inline-item(title="Git")
              +icon("brands/git")
            li.list-inline-item(title="GitHub")
              +icon("brands/github")
            li.list-inline-item(title="AWS")
              +icon("brands/aws")
            li.list-inline-item(title="npm")
              +icon("brands/npm")
            li.list-inline-item(title="HTML5")
              +icon("brands/html5")
            li.list-inline-item(title="CSS3")
              +icon("brands/css3-alt")
            li.list-inline-item(title="Ethereum")
              +icon("brands/ethereum")
            li.list-inline-item(title="Bitcoin")
              +icon("brands/bitcoin")
          .subheading.mb-3 Workflow
          ul.icon-list.mb-0
            li
              span.icon-list-bullet
                +icon("solid/check")
              | Programming Languages - Python, TypeScript, JavaScript, Solidity, Node.js, HTML, CSS
            li
              span.icon-list-bullet
                +icon("solid/check")
              | AI Engineering - LLM APIs, agent frameworks, MCP
            li
              span.icon-list-bullet
                +icon("solid/check")
              | Back-end Development - REST APIs, Express.js, Nestjs, MongoDB
            li
              span.icon-list-bullet
                +icon("solid/check")
              | Front-end Development - React.js, Next.js, React Native
            li
              span.icon-list-bullet
                +icon("solid/check")
              | DevOps and CI/CD - Git, GitHub, AWS, Vercel, Netlify
            li
              span.icon-list-bullet
                +icon("solid/check")
              | Blockchain Development - Foundry, Hardhat, Slither, Aderyn, OpenZeppelin, Chainlink
            li
              span.icon-list-bullet
                +icon("solid/check")
              | Web3 Technologies - Ethers.js, Viem, Wagmi, Web3.js, IPFS
          .subheading.mt-4.mb-3 Spoken Languages
          ul.icon-list.mb-0
            li
              span.icon-list-bullet
                +icon("solid/check")
              | French - Native
            li
              span.icon-list-bullet
                +icon("solid/check")
              | English - Very Fluent
            li
              span.icon-list-bullet
                +icon("solid/check")
              | Thai - Intermediate

      hr.m-0

      // Portfolio
      section#portfolio.resume-section
        .resume-section-content
          h2.mb-5 Portfolio & Open Source

          -
            const projects = [
              {
                title: "AuditAgent",
                desc: "AI pre-audit security scanner for smart contracts, at Nethermind.",
                stack: "Python, TypeScript, LLM APIs, MCP, Kubernetes, KEDA",
                url: "https://auditagent.nethermind.io/",
                img: "auditagent.webp",
              },
              {
                title: "AI Playbook",
                desc: "A practical guide to using AI well, in products and as a coding tool.",
                stack: "MkDocs Material, Vercel",
                url: "https://ai-playbook.pedrojok.com/",
                img: "ai-playbook.webp",
              },
              {
                title: "Fury Racing",
                stack: "Foundry, Solidity, Chainlink, Next.js, TypeScript, Nodejs, Lambda",
                url: "https://fury-racing.vercel.app/",
                img: "fury.webp",
                repo: "https://github.com/Pedrojok01/fury-racing",
              },
              {
                title: "Web3 Boilerplate",
                stack: "Next.js, TypeScript, @web3-react^8, Antd",
                url: "https://web3-boilerplate.netlify.app",
                img: "web3_boilerplate.webp",
                repo: "https://github.com/Pedrojok01/Web3-Boilerplate",
              },
              {
                title: "PackMyNFT",
                stack: "Foundry, Next.js, TypeScript, Wagmi, Viem, @chakra-ui",
                url: "https://packmynft.com/",
                img: "packmynft.webp",
                repo: "https://github.com/Pedrojok01/PackMyNFT",
              },
              {
                title: "Personal Travel Blog",
                stack: "Next.js, TypeScript, Antd, AWS S3",
                url: "https://www.voyageboost.com/",
                img: "voyageboost.webp",
              },
              {
                title: "MoveMyNFT",
                stack: "Hardhat, Next.js, TypeScript, Wagmi, Viem, Antd",
                url: "https://movemynft.com/",
                img: "movemynft.webp",
                repo: "https://github.com/Pedrojok01/MoveMyNFT",
              },
              {
                title: "CryptoCats",
                stack: "Hardhat, Next.js, TypeScript, Wagmi, @chakra-ui",
                url: "https://crypto-cats.netlify.app/",
                img: "cryptocats.webp",
                repo: "https://github.com/Pedrojok01/CryptoCats",
              },
            ];

          .row
            each p in projects
              +project(p)

      hr.m-0

      // Education
      section#education.resume-section
        .resume-section-content
          h2.mb-5 Education

          .d-flex.flex-column.flex-md-row.justify-content-between.mb-5
            .flex-grow-1
              h3.mb-0 Moralis Academy
              .subheading.mb-3 Blockchain, DeFi and Smart-Contract Programming
            .flex-shrink-0
              span.text-primary September 2020 - October 2021

          .d-flex.flex-column.flex-md-row.justify-content-between
            .flex-grow-1
              h3.mb-0 Paul Valery University
              .subheading.mb-3 Bachelor of Art in Economics
            .flex-shrink-0
              span.text-primary September 2004 - June 2007

      hr.m-0

      // Awards
      section#awards.resume-section
        .resume-section-content
          h2.mb-5 Awards & Certifications

          .subheading.mb-3 Hackathons
          ul.icon-list.mb-0
            li
              span.icon-list-bullet
                +icon("solid/trophy").text-warning
              | 1#[sup st] Place - <a href="https://blog.chain.link/block-magic-winners/#gaming_&_consumer_apps_($15_000)">Chainlink Block Magic Hackathon</a> - May 2024
            li.mb-3
              span.icon-list-bullet
                +icon("solid/trophy").text-warning
              | 2#[sup nd] Place - <a href="https://moralis.io/cronos-hackathon/">Moralis x Cronos Hackathon</a> - September 2022

          .subheading.mb-3 Certifications
          ul.icon-list.mb-0
            li
              span.icon-list-bullet
                +icon("solid/trophy").text-warning
              | Ethereum Dapp Programming - <a href="https://academy.moralis.io/">Moralis Academy</a> 2021
            li
              span.icon-list-bullet
                +icon("solid/trophy").text-warning
              | Ethereum Smart-Contract Security - Ivan on Tech Blockchain Academy 2021

      hr.m-0

      // Interests
      section#interests.resume-section
        .resume-section-content
          h2.mb-5 Interests
          p
            | Apart from blockchain development and crypto, I have been traveling a lot around the world, from
            | playing poker in Vegas, diving in Thailand, skydiving in New Zealand, climbing over
            | 6,000 m in Ladakh in Northern India, and going over the polar circle in Norway. I eventually
            | settled in Thailand's countryside, where I enjoy a quiet life with my wife and kids.
          p.mb-0
            | Here is my website relating most of my adventures:
            | <a href="https://www.voyageboost.com">https://www.voyageboost.com</a>

    // Bootstrap JS (same version as the SCSS)
    script(src="js/bootstrap.bundle.min.js")

    // Core theme JS
    script(src="js/scripts.js")
